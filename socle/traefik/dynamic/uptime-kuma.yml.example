# Exemple de config dynamique (provider file) -- route Uptime Kuma via
# Traefik SANS le faire rejoindre net_proxy : Uptime Kuma garde tel quel
# son acces direct existant (UPTIME_KUMA_BIND_ADDR:3001, cf.
# uptime-kuma.env.example de socle/uptime-kuma/), Traefik pointe simplement
# dessus comme un backend "delocalise" (meme mecanisme que
# dynamic/exemple-delocalise.yml.example et dynamic/portainer.yml.example,
# cf. README.md "Pourquoi Portainer n'est pas sur net_proxy" -- ici, le
# provider Docker de Traefik est casse/inutilise, pas juste evite par
# choix). Zero label, zero reseau Docker partage. A copier dans
# TRAEFIK_DYNAMIC_CONFIG_DIR, adapter le host et l'IP:port (=
# UPTIME_KUMA_BIND_ADDR reel + :3001).

http:
  routers:
    uptime-kuma:
      rule: "Host(`status.exemple.com`)"
      service: uptime-kuma
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt

  services:
    uptime-kuma:
      loadBalancer:
        servers:
          # IP:port deja publies par Uptime Kuma sur l'hote
          # (UPTIME_KUMA_BIND_ADDR + port 3001, cf.
          # socle/uptime-kuma/compose.yaml) -- pas l'IP Docker interne
          # d'Uptime Kuma (10.1.3.100, non joignable depuis le conteneur
          # Traefik, reseaux Docker isoles l'un de l'autre).
          - url: "http://192.0.2.10:3001"
