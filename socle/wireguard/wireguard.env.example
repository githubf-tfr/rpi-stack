# Modele de wireguard.env -- copier a cote de compose.yaml (meme dossier),
# remplir avec les vraies valeurs du deploiement consommateur, ne jamais
# committer le fichier reel dans CE repo (generique, sans valeur concrete).

# Nom du conteneur -- formalisme nomdelastack_xxx, juste "nomdelastack" si
# un seul conteneur dans la stack (cas ici).
WIREGUARD_CONTAINER_NAME=wireguard

# Image linuxserver.io : PUID/PGID (utilisateur hote proprietaire des
# fichiers montes, cf. docs linuxserver.io) et TZ (fuseau horaire des logs).
WIREGUARD_PUID=1000
WIREGUARD_PGID=1000
WIREGUARD_TZ=Europe/Paris

# IP sur laquelle WireGuard ecoute (port UDP 51820 fixe). A choisir selon
# ton reseau -- typiquement l'IP publique/uplink si le VPN doit etre
# joignable depuis l'exterieur (cas d'usage meme de cette stack), ou une IP
# dediee si un routeur en amont fait deja le NAT/port-forward. Exemple
# ci-dessous : plage documentaire RFC 5737, a remplacer par une IP reelle.
WIREGUARD_BIND_ADDR=192.0.2.10

# Sous-reseau Docker interne dedie a cette stack (jamais route vers
# l'exterieur de l'hote), TOUJOURS en /24. IP fixe de WireGuard dedans --
# convention d'adressage rpi-stack : .100 = serveur/web, .10 = bdd (ici, un
# seul conteneur, .100). C'est l'IP du CONTENEUR sur le reseau Docker de
# l'hote -- pas l'adressage interne du tunnel WireGuard lui-meme (cf.
# wg_confs/wg0.conf.example et README.md "Plan d'adressage reseau"
# ci-dessous pour cette distinction). Allocation officielle : 5eme /24 du
# bloc socle 10.1.0.0/16.
WIREGUARD_NETWORK_SUBNET=10.1.4.0/24
WIREGUARD_NETWORK_IP=10.1.4.100

# Nom de reseau Docker et nom d'interface bridge -- deux variables
# distinctes (formalisme "net_xxx" pour les deux), a garder identiques par
# convention (cf. compose.yaml) sauf besoin explicite de les decoupler.
WIREGUARD_NETWORK_NAME=net_wireguard
WIREGUARD_NETWORK_IFACE=net_wireguard

# Chemin hote (doit deja exister, cf. compose.yaml) ou WireGuard persiste sa
# config + son etat -- DOIT contenir wg_confs/wg0.conf (prive, cles
# incluses -- adapte depuis wg_confs/wg0.conf.example) AVANT le premier
# deploiement, sans quoi l'image bascule en generation automatique de peers
# (mode non voulu ici, cf. compose.yaml).
WIREGUARD_CONFIG_DIR=/srv/docker/wireguard/config

# PAS de variable ici pour l'adressage interne du tunnel WireGuard
# (Address=/AllowedIPs de wg0.conf, allocation officielle : 10.1.5.0/24,
# 6eme /24 du bloc socle -- reserve pour ce tunnel mais jamais passe en
# ${VAR} Compose) : ce n'est pas une valeur de compose.yaml, elle vit
# entierement dans wg_confs/wg0.conf (fichier de config applicative
# complete, non decoupable en ${VAR} -- cf. wg_confs/wg0.conf.example et
# CLAUDE.md "Cas particulier : config applicative non decoupable en
# ${VAR}").
