# Modele de uptime-kuma.env -- copier a cote de compose.yaml (meme dossier),
# remplir avec les vraies valeurs du deploiement consommateur, ne jamais
# committer le fichier reel dans CE repo (generique, sans valeur concrete).

# Nom du conteneur -- formalisme nomdelastack_xxx, juste "nomdelastack" si
# un seul conteneur dans la stack (cas ici).
UPTIME_KUMA_CONTAINER_NAME=uptime-kuma

# IP sur laquelle Uptime Kuma expose son UI (port 3001 interne, fixe). A
# choisir selon ton reseau -- eviter 0.0.0.0 si tu veux limiter l'exposition
# (cf. compose.yaml). Exemple ci-dessous : plage documentaire RFC 5737, a
# remplacer par une IP reelle de ton hote/reseau.
UPTIME_KUMA_BIND_ADDR=192.0.2.10

# Sous-reseau Docker interne dedie a cette stack (jamais route vers
# l'exterieur de l'hote), TOUJOURS en /24. IP fixe d'Uptime Kuma dedans --
# convention d'adressage rpi-stack : .100 = serveur/web, .10 = bdd (ici, un
# seul conteneur, .100). Allocation officielle (cf. plan d'adressage reseau
# dans README.md) : 4eme /24 du bloc socle 10.1.0.0/16.
UPTIME_KUMA_NETWORK_SUBNET=10.1.3.0/24
UPTIME_KUMA_NETWORK_IP=10.1.3.100

# Nom de reseau Docker et nom d'interface bridge -- deux variables
# distinctes (formalisme "net_xxx" pour les deux), a garder identiques par
# convention (cf. compose.yaml) sauf besoin explicite de les decoupler.
# ATTENTION : "net_uptime-kuma" fait deja 15 caracteres, la limite Linux
# IFNAMSIZ pour un nom d'interface -- ne pas l'allonger.
UPTIME_KUMA_NETWORK_NAME=net_uptime-kuma
UPTIME_KUMA_NETWORK_IFACE=net_uptime-kuma

# Chemin hote (doit deja exister, cf. compose.yaml) ou Uptime Kuma persiste
# ses donnees (base SQLite + captures d'ecran de monitors) -- typiquement
# sur la partition dediee aux donnees de stacks.
UPTIME_KUMA_DATA_DIR=/srv/docker/uptime-kuma/data

# Uptime Kuma ne rejoint PAS le reseau partage net_proxy et n'a aucun label
# traefik.* -- le provider Docker de Traefik est casse/inutilise dans ce
# repo (incompatibilite de version). S'il faut le mettre en TLS derriere
# Traefik, ca se fait cote traefik (provider file, IP:port =
# UPTIME_KUMA_BIND_ADDR ci-dessus + :3001), pas ici. Cf.
# socle/traefik/dynamic/uptime-kuma.yml.example et README.md "Pourquoi
# Portainer n'est pas sur net_proxy".
