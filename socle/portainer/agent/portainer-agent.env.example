# Modele de portainer-agent.env -- copier a cote de compose.yaml (meme
# dossier), remplir avec les vraies valeurs du deploiement consommateur, ne
# jamais committer le fichier reel dans CE repo (generique, sans valeur
# concrete). Le pourquoi de chaque valeur reste ici, en exemple.

# Nom du conteneur -- formalisme nomdelastack_xxx, juste "nomdelastack" si
# un seul conteneur dans la stack (cas ici).
PORTAINER_AGENT_CONTAINER_NAME=portainer_agent

# IP sur laquelle l'agent expose son API (port 9001 interne), sondee par le
# Portainer serveur distant. Exemple ci-dessous : plage documentaire
# RFC 5737, a remplacer par une IP reelle de ton hote/reseau.
PORTAINER_AGENT_BIND_ADDR=192.0.2.20

# Sous-reseau Docker interne dedie a cette stack (jamais route vers
# l'exterieur de l'hote), TOUJOURS en /24. IP fixe de l'agent dedans --
# convention d'adressage rpi-stack : .100 = serveur/web (ici, un seul
# conteneur, .100). Reutilise DELIBEREMENT le meme /24 que
# socle/portainer/serveur/ (10.1.0.0/24, cf. plan d'adressage reseau dans
# README.md) : un sous-reseau Docker n'est unique qu'a l'echelle d'un hote,
# et serveur/agent ne tournent jamais sur le meme hote (le serveur
# gererait sinon son propre hote via l'agent, ce qui n'a pas de sens) --
# cf. README.md "Dérogations réseau" pour le detail.
PORTAINER_AGENT_NETWORK_SUBNET=10.1.0.0/24
PORTAINER_AGENT_NETWORK_IP=10.1.0.100

# Nom de reseau Docker et nom d'interface bridge -- deux variables
# distinctes (formalisme "net_xxx" pour les deux), a garder identiques par
# convention (cf. compose.yaml) sauf besoin explicite de les decoupler.
PORTAINER_AGENT_NETWORK_NAME=net_portainer
PORTAINER_AGENT_NETWORK_IFACE=net_portainer
